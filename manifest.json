{
  "manifest_version": 3,
  "name": "Save Image as PNG",
  "version": "1.1",
  "description": "Right-click any image to save it directly as a PNG file.",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
